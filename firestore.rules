rules_version = '2';

// Keamanan sistem ini sepenuhnya ada di file ini, bukan di
// JavaScript. Kode di browser bisa dibaca dan diubah siapa saja.

service cloud.firestore {
  match /databases/{database}/documents {

    function masuk() {
      return request.auth != null;
    }
    function profil() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function aktif() {
      return masuk() && profil().aktif == true;
    }
    function peranSaya() {
      return profil().peran;
    }
    function salahSatu(daftar) {
      return aktif() && peranSaya() in daftar;
    }
    function batasSaya() {
      return profil().batasDiskon;
    }

    // ── Karyawan ────────────────────────────────────────────
    match /users/{uid} {
      allow read: if aktif() && (request.auth.uid == uid || salahSatu(['owner']));
      allow create, update: if salahSatu(['owner']);
      // Karyawan keluar dinonaktifkan, tidak dihapus — kalau dihapus,
      // transaksi lamanya kehilangan pemilik dan laporan komisi rusak.
      allow delete: if false;
    }

    // ── Log aktivitas ───────────────────────────────────────
    // Boleh dibuat, tidak boleh diubah atau dihapus oleh siapa pun,
    // termasuk owner. Log yang bisa dihapus tidak berguna sebagai bukti.
    match /audit_log/{id} {
      allow create: if aktif() && request.resource.data.uid == request.auth.uid;
      allow read:   if salahSatu(['owner']);
      allow update, delete: if false;
    }

    // ── Penomoran & indeks keunikan ─────────────────────────
    match /counters/{id} {
      allow read, write: if aktif();
    }
    match /indeks_rangka/{noRangka} {
      allow read:   if aktif();
      allow create: if salahSatu(['owner', 'admin']);
      allow update, delete: if salahSatu(['owner']);
    }

    // ── Master tipe motor ───────────────────────────────────
    match /tipe_motor/{id} {
      allow read:  if aktif();
      allow write: if salahSatu(['owner', 'admin']);
    }

    // ── Unit fisik ──────────────────────────────────────────
    match /units/{id} {
      allow read:  if aktif();
      allow write: if salahSatu(['owner', 'admin']);

      // Harga beli, biaya, dan margin dipisah ke sini supaya sales
      // dan kasir tidak bisa membacanya lewat developer tools.
      match /rahasia/{doc} {
        allow read, write: if salahSatu(['owner', 'admin']);
      }
    }

    // ── Katalog publik ──────────────────────────────────────
    // Hanya berisi field aman: tipe, warna, harga jual, spesifikasi.
    match /katalog/{id} {
      allow read:  if true;
      allow write: if salahSatu(['owner', 'admin']);
    }

    // ── SPK & transaksi ─────────────────────────────────────
    match /transaksi/{id} {
      allow read:   if aktif();
      allow create: if salahSatu(['owner', 'admin', 'sales']);
      allow update: if salahSatu(['owner', 'admin', 'sales', 'kasir']);
      allow delete: if false; // dibatalkan, bukan dihapus

      match /pembayaran/{bayar} {
        allow read:   if aktif();
        allow create: if salahSatu(['owner', 'kasir']);
        allow update, delete: if false;
      }

      // Foto KTP, KK, slip gaji untuk pengajuan leasing.
      // Sales tidak perlu melihat ini untuk menelepon konsumen.
      match /berkas/{doc} {
        allow read, write: if salahSatu(['owner', 'admin']);
      }
    }

    // ── Pelanggan ───────────────────────────────────────────
    // Data tindak lanjut: nama, telepon, riwayat pembelian.
    match /pelanggan/{id} {
      allow read:  if aktif();
      allow write: if salahSatu(['owner', 'admin', 'sales']);
    }

    // ── Kas & kuitansi ──────────────────────────────────────
    match /kas/{id} {
      allow read:   if salahSatu(['owner', 'admin', 'kasir']);
      allow create: if salahSatu(['owner', 'admin', 'kasir']);
      allow update, delete: if false; // hanya dibatalkan dengan dokumen lawan
    }
    match /kuitansi/{id} {
      allow read:   if aktif();
      allow create: if salahSatu(['owner', 'kasir']);
      // Void ditandai lewat update terbatas, dokumen tidak pernah hilang.
      allow update: if salahSatu(['owner']);
      allow delete: if false;
    }

    // ── Verifikasi publik (QR kuitansi) ─────────────────────
    // Boleh dibaca siapa pun yang memindai QR. Isinya sengaja
    // minimal — tidak ada NIK, alamat, atau nomor rangka.
    // Kuncinya token acak, bukan nomor urut, supaya dokumen lain
    // tidak bisa ditebak dari satu contoh.
    match /verifikasi/{token} {
      allow read:   if true;
      allow create: if salahSatu(['owner', 'kasir']);
      allow update: if salahSatu(['owner']);
      allow delete: if false;
    }

    // ── Agen & fee ──────────────────────────────────────────
    match /agen/{id} {
      allow read, write: if salahSatu(['owner', 'kasir']);
    }

    // ── Ringkasan bulanan ───────────────────────────────────
    match /ringkasan/{bulan} {
      allow read:  if salahSatu(['owner', 'admin']);
      allow write: if aktif();
    }

    // Apa pun yang tidak disebut di atas: ditolak.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
